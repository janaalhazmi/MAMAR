# Copy this file to .env and put your own values in it.
# Never commit the .env file.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mamar

# Signs the login tokens (JWT). Put a long random value, for example the output of:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_long_random_value

# Frontend addresses allowed to call the API, separated by commas
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email verification with a 6-digit passcode: off or on. Keep it off until the frontend sends the passcode.
EMAIL_VERIFICATION=off

# EmailJS keys that send the passcode emails (see the README). Without them, the passcode is written in the server log.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox). Empty: payments return 503.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The one admin account, created when the server starts (password: at least 8 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo accounts password (at least 8 characters)
DEMO_PASSWORD=
# Cloudflare Turnstile secret (the frontend uses VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
