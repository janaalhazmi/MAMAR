---
config:
  theme: base
  themeVariables:
    primaryColor: '#FEF3C7'
    primaryTextColor: '#1F2937'
    primaryBorderColor: '#D4A900'
    lineColor: '#374151'
    secondaryColor: '#F3F4F6'
    tertiaryColor: '#FFFFFF'
    background: '#FFFFFF'
    fontFamily: 'Arial'
    fontSize: '15px'
  flowchart:
    curve: linear
    nodeSpacing: 45
    rankSpacing: 55
    wrappingWidth: 280
---
flowchart TB

    U["<b>Users</b><br/>Contractor · Service Provider<br/>Field Worker · Administrator"]

    FE["<b>Frontend</b><br/>React 19 · Vite · Vercel<br/>ArcGIS Maps SDK<br/>Browser Geolocation"]

    BE["<b>Backend</b><br/>FastAPI · Render<br/>17 Routers · 86 Endpoints<br/>JWT · Role-Based Access<br/>Spatial Distance Validation"]

    DB[("<b>PostgreSQL — Supabase</b><br/>16 Tables · 26 Foreign Keys<br/>Work-Zone Geometry — JSON<br/>Device Coordinates<br/>Attendance and Field Records")]

    GIS["<b>ArcGIS Online</b><br/>Basemaps · Web Maps<br/>Geographic Layers<br/>Planned Device Features"]

    EXT["<b>External Services</b><br/>TomTom Traffic · Twilio WhatsApp<br/>EmailJS · PayPal Sandbox<br/>Anthropic Claude"]

    W["<b>Open-Meteo</b><br/>Weather Information"]

    BOT["<b>Cloudflare Turnstile</b><br/>Bot Protection"]

    DEV["<b>GitHub</b><br/>Production Branch: main<br/>GitHub Actions — CI Testing"]

    MON["<b>UptimeRobot</b><br/>Availability Monitoring"]

    U --> FE
    FE <-->|"HTTPS / REST API"| BE
    FE <-->|"Maps and Layers"| GIS
    BE <-->|"Device Reference Data"| GIS
    BE <-->|"SQLAlchemy"| DB
    BE <-->|"API Integrations"| EXT
    FE <-->|"Weather Data"| W
    FE -->|"Bot Challenge"| BOT
    BE -->|"Token Verification"| BOT
    DEV -.->|"Deployment"| FE
    DEV -.->|"Deployment"| BE
    MON -.->|"Health Check"| BE

    classDef core fill:#FACC15,stroke:#374151,color:#1F2937,stroke-width:2px
    classDef data fill:#FEF3C7,stroke:#D4A900,color:#1F2937,stroke-width:2px
    classDef service fill:#F3F4F6,stroke:#6B7280,color:#1F2937,stroke-width:1.5px
    classDef user fill:#1F2937,stroke:#1F2937,color:#FFFFFF,stroke-width:2px

    class U user
    class FE,BE core
    class DB,GIS data
    class EXT,W,BOT,DEV,MON service
