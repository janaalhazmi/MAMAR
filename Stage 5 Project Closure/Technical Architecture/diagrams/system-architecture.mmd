flowchart TB
    U["<b>Users</b><br/>Contractor · Provider · Field Worker · Admin"]
    FE["<b>Frontend</b> — React on Vercel<br/>React pages · ArcGIS Maps SDK<br/>Browser Geolocation · Open-Meteo weather"]
    BE["<b>Backend</b> — FastAPI on Render<br/>17 routers · 86 endpoints<br/>JWT login · role and project access checks"]
    DB[("<b>PostgreSQL</b> on Supabase<br/>16 tables")]
    EXT["<b>External services</b><br/>TomTom Traffic · Twilio WhatsApp · EmailJS<br/>PayPal Sandbox · Cloudflare Turnstile<br/>Anthropic Claude · ArcGIS Feature Service"]
    AGOL["<b>ArcGIS Online</b><br/>basemap · work zones · device layers"]

    U --> FE
    FE -->|"HTTPS · JSON · Bearer token"| BE
    FE -->|"map tiles and layers"| AGOL
    BE -->|"SQLAlchemy"| DB
    BE -->|"server-side calls"| EXT

