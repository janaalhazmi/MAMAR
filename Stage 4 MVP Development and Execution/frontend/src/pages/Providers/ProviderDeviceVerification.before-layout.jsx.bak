import { Link, useParams } from "react-router-dom";
import NotificationBell from "../../components/NotificationBell";
import ProviderSidebar from "../../components/ProviderSidebar";
import { getSession } from "../../services/auth";
import { useDeviceVerificationProjects } from "../../services/providers/api";

export default function ProviderDeviceVerification() {
  const { projectId } = useParams();

  const name = getSession()?.user?.full_name || "Provider";
  const initials =
    name
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((word) => word.charAt(0).toUpperCase())
      .join("") || "P";

  const { projects, loadError } = useDeviceVerificationProjects();

  const selected = projects?.find(
    (project) => String(project.id) === projectId
  );

  return (
    <div className="provider-dashboard-page">
      <ProviderSidebar />

      <div className="provider-main-area">
        <header className="provider-topbar">
          <div />

          <div className="provider-account">
            <div className="provider-avatar">{initials}</div>
            <div>
              <strong>{name}</strong>
              <span>Service Provider</span>
            </div>
          </div>

          <div
            style={{
              marginLeft: "auto",
              display: "flex",
              alignItems: "center",
            }}
          >
            <NotificationBell />
          </div>
        </header>

        <main className="provider-dashboard-content">
          {projectId && (
            <p>
              <Link to="/provider/device-verification">
                ← Back to Projects
              </Link>
            </p>
          )}

          <section className="provider-title">
            <h1>Device Verification Status</h1>
            <p>
              Monitor device verification across your assigned projects.
            </p>
          </section>

          {loadError ? (
            <p role="alert">{loadError}</p>
          ) : projects === null ? (
            <p role="status">Loading projects...</p>
          ) : !projectId ? (
            <section
              className="provider-section"
              aria-label="Assigned projects"
            >
              {projects.length === 0 && (
                <p>No assigned projects yet.</p>
              )}

              {projects.map((project) => (
                <article
                  className="assigned-project-card"
                  key={project.id}
                >
                  <div>
                    <h3>{project.name}</h3>
                    <p>{project.status || "Status unavailable"}</p>
                  </div>

                  <Link
                    to={
                      "/provider/device-verification/" +
                      encodeURIComponent(project.id)
                    }
                  >
                    View Details →
                  </Link>
                </article>
              ))}
            </section>
          ) : selected ? (
            <ProjectVerificationStatus project={selected} />
          ) : (
            <p role="alert">
              This project is not in your assigned projects.
            </p>
          )}
        </main>
      </div>
    </div>
  );
}

function ProjectVerificationStatus({ project }) {
  return (
    <div className="pdv-details">
      <dl className="pdv-card pdv-summary">
        <div>
          <dt>Project</dt>
          <dd>{project.name}</dd>
        </div>

        <div>
          <dt>Project ID</dt>
          <dd>{project.code || project.id}</dd>
        </div>

        <div>
          <dt>Project Status</dt>
          <dd>{project.status || "Not available"}</dd>
        </div>

        <div>
          <dt>Location</dt>
          <dd>{project.location || "Not available"}</dd>
        </div>
      </dl>

      <div className="pdv-grid">
        <section className="pdv-card">
          <h2>Project Information</h2>
          <dl className="pdv-coords">
            <div>
              <dt>Start Date</dt>
              <dd>{project.startDate || "Not available"}</dd>
            </div>

            <div>
              <dt>End Date</dt>
              <dd>{project.endDate || "Not available"}</dd>
            </div>

            <div>
              <dt>Field Team</dt>
              <dd>
                {project.teamCount != null
                  ? `${project.teamCount} workers`
                  : "Not available"}
              </dd>
            </div>
          </dl>
        </section>

        <section className="pdv-card">
          <h2>Device Verification</h2>

          <p>
            Device verification is performed by assigned field workers.
          </p>

          <p role="status">
            Device verification records are not available yet.
          </p>

          <p className="pdv-note">
            Device details and verification results will appear
            here when the backend supports retrieving them.
          </p>
        </section>
      </div>
    </div>
  );
}
